#!/usr/bin/env python3
"""Launch one command on every host, syncing the current checkout when in Buildkite."""
import concurrent.futures
import fcntl
import json
import os
import shlex
import signal
import socket
import subprocess
import sys
import time
import threading
import uuid

HOSTS = json.load(open('/opt/tpu-ci/config.json'))['hosts']
SSH = ['ssh', '-p', '2222', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', '-o', 'StrictHostKeyChecking=accept-new']

def remote(host, command, **kwargs):
    return subprocess.run([*SSH, f'buildkite-agent@{host}', command], stdin=subprocess.DEVNULL, **kwargs)

def main():
    if len(sys.argv) < 2:
        sys.exit('Usage: tpu-run COMMAND [ARG ...]')
    lock = open('/var/lib/buildkite-agent/tpu-run.lock', 'w')
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    unit = 'tpu-ci-' + uuid.uuid4().hex
    processes = []
    def stop(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    coordinator = socket.gethostbyname(HOSTS[0]) + ':12345'
    cwd = '/var/lib/buildkite-agent'
    checkout = os.environ.get('BUILDKITE_BUILD_CHECKOUT_PATH')
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(HOSTS)) as pool:
            checks = list(pool.map(lambda h: remote(h, 'test -f /run/tpu-ci-ready', timeout=30).returncode, HOSTS))
        if any(checks):
            sys.exit('All slice hosts must finish bootstrap before launching')
        if checkout and os.path.commonpath([os.getcwd(), checkout]) == checkout:
            root = '/var/lib/buildkite-agent/tpu-work/' + unit
            cwd = root + '/' + os.path.relpath(os.getcwd(), checkout)
            def sync(host):
                remote(host, 'mkdir -p ' + shlex.quote(root), check=True, timeout=30)
                subprocess.run(['rsync', '-a', '--delete', '-e', shlex.join(SSH), checkout+'/', f'buildkite-agent@{host}:{root}/'], check=True, timeout=300)
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(HOSTS)) as pool:
                list(pool.map(sync, HOSTS))
        for rank, host in enumerate(HOSTS):
            args = ['sudo', '-n', 'systemd-run', '--quiet', '--collect', '--wait', '--pipe', '--service-type=exec', '--unit='+unit,
                    '--uid=buildkite-agent', '--gid=buildkite-agent', '--property=RuntimeMaxSec='+os.environ.get('TPU_RUN_TIMEOUT', '3600'),
                    '--property=TimeoutStopSec=15', '--property=LimitMEMLOCK=infinity', '--working-directory='+cwd, '--setenv=HOME=/var/lib/buildkite-agent',
                    '--setenv=TPU_HOST_COUNT='+str(len(HOSTS)), '--setenv=TPU_PROCESS_ID='+str(rank), '--setenv=JAX_COORDINATOR_ADDRESS='+coordinator,
                    '--setenv=PYTHONUNBUFFERED=1', '--', *sys.argv[1:]]
            processes.append(subprocess.Popen([*SSH, f'buildkite-agent@{host}', shlex.join(args)], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True))
        def output(rank):
            for line in processes[rank].stdout:
                print(f'[host {rank}] {line}', end='', flush=True)
        readers = [threading.Thread(target=output, args=(rank,), daemon=True) for rank in range(len(HOSTS))]
        for reader in readers:
            reader.start()
        while any(p.poll() is None for p in processes):
            failed = next((p.returncode for p in processes if p.poll() not in (None, 0)), None)
            if failed:
                return failed
            time.sleep(0.2)
        for reader in readers:
            reader.join(timeout=5)
        return max(p.wait() for p in processes)
    except KeyboardInterrupt:
        return 130
    finally:
        def cleanup(host):
            command = 'sudo -n systemctl stop '+unit+' 2>/dev/null || true'
            if checkout and cwd.startswith('/var/lib/buildkite-agent/tpu-work/'+unit):
                command += '; rm -rf ' + shlex.quote('/var/lib/buildkite-agent/tpu-work/'+unit)
            try:
                remote(host, command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
            except subprocess.TimeoutExpired:
                print('Could not confirm cleanup on '+host, file=sys.stderr)
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(HOSTS)) as pool:
            list(pool.map(cleanup, HOSTS))
        for process in processes:
            if process.poll() is None:
                process.terminate()
if __name__ == '__main__':
    sys.exit(main())
