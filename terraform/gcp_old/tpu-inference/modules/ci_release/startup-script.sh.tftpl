#!/bin/bash
set -e

# Keep the agent offline until the hooks below are in place; it is unmasked at
# the end. This script re-runs on every boot, and the unit is enabled from the
# previous run, so systemd would otherwise start the agent before the
# allowlist is rewritten. The agent package's postinst restarts the unit on
# upgrade, and a mask blocks that too.
systemctl mask buildkite-agent 2>/dev/null || true
timeout 30 systemctl stop buildkite-agent 2>/dev/null \
  || systemctl kill -s SIGKILL buildkite-agent 2>/dev/null \
  || true

apt-get update
apt-get install -y curl jq git python3

if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com/ | bash -
fi

curl -fsSL https://keys.openpgp.org/vks/v1/by-fingerprint/32A37959C2FA5C3C99EFBC32A79206696452D198 | gpg --dearmor --yes -o /usr/share/keyrings/buildkite-agent-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/buildkite-agent-archive-keyring.gpg] https://apt.buildkite.com/buildkite-agent stable main" > /etc/apt/sources.list.d/buildkite-agent.list
apt-get update
apt-get install -y buildkite-agent

mkdir -p /etc/buildkite-agent/hooks

# Only the pipelines this VM publishes for may run here. The VM's service
# account and the secrets its queue unlocks are theirs, and a pipeline added to
# the cluster later must reach neither. Buildkite has no per-queue pipeline
# list, so the agent enforces it: pre-bootstrap runs before checkout, and a
# non-zero exit rejects the job.
cat <<'EOF' > /etc/buildkite-agent/hooks/pre-bootstrap
#!/bin/bash
# The IDs come from the job, so split them without expanding globs.
set -f
allowed=" ${allowed_pipeline_ids} "
# The job's environment, one KEY="value" per line. Every BUILDKITE_PIPELINE_ID
# line has to be on the list, in case the step's own env repeats the name.
ids=$(sed -n 's/^BUILDKITE_PIPELINE_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$BUILDKITE_ENV_FILE")
if [ -z "$ids" ]; then
  echo "pre-bootstrap: the job names no pipeline, so this agent refuses it." >&2
  exit 1
fi
for id in $ids; do
  case "$allowed" in
    *" $id "*) ;;
    *)
      echo "pre-bootstrap: pipeline $id may not run on this agent." >&2
      exit 1
      ;;
  esac
done
EOF

# vllm-torchtpu is private and checked out over SSH with its read-only deploy
# key, the TPU Release cluster secret VLLM_TORCHTPU_DEPLOY_KEY. Its policy
# names the pipeline and queue that may read it. tpu-inference is public and
# checked out over HTTPS, which this hook leaves alone.
cat <<'EOF' > /etc/buildkite-agent/hooks/pre-checkout
#!/bin/bash
case "$BUILDKITE_REPO" in
  git@github.com:vllm-project/vllm-torchtpu.git|ssh://git@github.com/vllm-project/vllm-torchtpu.git)
    key_file=$(mktemp)
    if buildkite-agent secret get VLLM_TORCHTPU_DEPLOY_KEY > "$key_file" && [ -s "$key_file" ]; then
      export GIT_SSH_COMMAND="ssh -i $key_file -o IdentitiesOnly=yes -o BatchMode=yes"
      export VLLM_TORCHTPU_DEPLOY_KEY_FILE="$key_file"
    else
      rm -f "$key_file"
      # Fail the checkout instead of waiting at a prompt.
      export GIT_SSH_COMMAND="ssh -o BatchMode=yes"
      echo "pre-checkout: this pipeline can't read VLLM_TORCHTPU_DEPLOY_KEY, so the checkout will fail." >&2
    fi
    ;;
esac
EOF
cat <<'EOF' > /etc/buildkite-agent/hooks/pre-exit
#!/bin/bash
if [ -n "$VLLM_TORCHTPU_DEPLOY_KEY_FILE" ]; then
  rm -f "$VLLM_TORCHTPU_DEPLOY_KEY_FILE"
fi
EOF

# Root-owned, so a job, which runs as buildkite-agent, can't rewrite the hooks
# later jobs run.
chown root:root /etc/buildkite-agent/hooks /etc/buildkite-agent/hooks/pre-bootstrap /etc/buildkite-agent/hooks/pre-checkout /etc/buildkite-agent/hooks/pre-exit
chmod 755 /etc/buildkite-agent/hooks /etc/buildkite-agent/hooks/pre-bootstrap /etc/buildkite-agent/hooks/pre-checkout /etc/buildkite-agent/hooks/pre-exit

# Pin GitHub's SSH host keys, read over HTTPS from its meta API. The agent
# doesn't run ssh-keyscan before a checkout, so without this the first SSH
# clone stops at a host key prompt.
github_host_keys=$(curl -fsSL https://api.github.com/meta | jq -r '.ssh_keys[] | "github.com " + .')
if [ -n "$github_host_keys" ]; then
  touch /etc/ssh/ssh_known_hosts
  sed -i '/^github\.com /d' /etc/ssh/ssh_known_hosts
  echo "$github_host_keys" >> /etc/ssh/ssh_known_hosts
fi

usermod -a -G docker buildkite-agent
# vllm-torchtpu's images go to Artifact Registry in us-central1.
sudo -u buildkite-agent gcloud auth configure-docker us-central1-docker.pkg.dev --quiet

${read_secret_function}
BUILDKITE_AGENT_TOKEN=$(read_secret "${buildkite_token_secret_name}") || exit 1

# Whole-line matches, since this runs again on every boot against the config
# the previous boot wrote.
sed -i -E "s|^token=.*|token=\"$BUILDKITE_AGENT_TOKEN\"|" /etc/buildkite-agent/buildkite-agent.cfg
sed -i -E 's|^name=.*|name="${node_name}"|' /etc/buildkite-agent/buildkite-agent.cfg
sed -i '/^tags=/d' /etc/buildkite-agent/buildkite-agent.cfg
echo 'tags="queue=${buildkite_queue_name}"' >> /etc/buildkite-agent/buildkite-agent.cfg

${keep_agent_connected}

systemctl restart docker

systemctl unmask buildkite-agent
systemctl enable buildkite-agent
systemctl restart buildkite-agent
