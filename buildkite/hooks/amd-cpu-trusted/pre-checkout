#!/bin/bash
# Agent pre-checkout hook for the amd-cpu-trusted queue, whose agents alone hold push credentials for
# rocm/vllm-ci and rocm/vllm-ci-cache. It runs before the checkout, so before any repository hook or
# code, and admits only main's build.sh on a commit that is on vllm-project/vllm main:
#   build.sh rocm base|ci   test-template-amd.j2 routes main's build steps here
#   build.sh rocm prebuild  a PR's stack pre-build, once a maintainer approved ROCM_PREBUILD_SHA
# A prebuild needs ROCM_TRUSTED_GITHUB_TOKEN (read-only) to check the approver's permission.
set -euo pipefail

VLLM=https://github.com/vllm-project/vllm.git
API=https://api.github.com/repos/vllm-project/vllm
BUILD_SH="bash .buildkite/scripts/rocm/build.sh rocm"

die() { echo "amd-cpu-trusted: refusing job: $*" >&2; exit 1; }

github() {
  curl -fsSL -H "Authorization: Bearer ${ROCM_TRUSTED_GITHUB_TOKEN:?}" \
    -H "Accept: application/vnd.github+json" "$API/$1"
}

check_prebuild_approval() {
  local pr=${ROCM_PREBUILD_PR:-} sha=${ROCM_PREBUILD_SHA:-} user perm
  [[ $pr =~ ^[0-9]+$ && $sha =~ ^[0-9a-f]{40}$ ]] || die "prebuild needs ROCM_PREBUILD_PR and ROCM_PREBUILD_SHA"
  for user in $(github "pulls/$pr/reviews?per_page=100" | jq -r --arg sha "$sha" \
      '.[] | select(.state == "APPROVED" and .commit_id == $sha) | .user.login'); do
    perm=$(github "collaborators/$user/permission" | jq -r .permission)
    [[ $perm == admin || $perm == write ]] && { echo "#$pr $sha approved by $user ($perm)"; return 0; }
  done
  die "no approval of $sha on #$pr by a maintainer"
}

[[ ${BUILDKITE_PULL_REQUEST:-} == false ]] || die "PR builds never run here"
[[ ${BUILDKITE_BRANCH:-} == main ]] || die "only main builds run here"
[[ ${BUILDKITE_REPO:-} =~ ^(https://github\.com/|git@github\.com:)vllm-project/vllm(\.git)?$ ]] \
  || die "not vllm-project/vllm: ${BUILDKITE_REPO:-}"
[[ ${BUILDKITE_COMMIT:-} =~ ^[0-9a-f]{40}$ ]] || die "not a full commit SHA: ${BUILDKITE_COMMIT:-}"
[[ ${BUILDKITE_PLUGINS:-[]} == "[]" ]] || die "plugins are not allowed"
case ${BUILDKITE_COMMAND:-} in
  "$BUILD_SH base" | "$BUILD_SH ci") ;;
  "$BUILD_SH prebuild") check_prebuild_approval ;;
  *) die "command not allowed: ${BUILDKITE_COMMAND:-}" ;;
esac

# The branch name of a manual or triggered build is free text: the commit itself must be on main.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git -C "$tmp" init -q
git -C "$tmp" fetch -q --filter=tree:0 --depth=1000 "$VLLM" main
git -C "$tmp" merge-base --is-ancestor "$BUILDKITE_COMMIT" FETCH_HEAD 2>/dev/null \
  || die "$BUILDKITE_COMMIT is not in main's last 1000 commits"
