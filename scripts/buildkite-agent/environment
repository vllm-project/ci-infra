#!/usr/bin/env bash
# Buildkite agent environment hook for an H200 MIG machine.
#
# Install at: /etc/buildkite-agent/hooks/environment
# Owner: root, mode 0755. Sourced by every job before it runs.
#
# What it does:
#   1. Exports secrets (HF_TOKEN, AWS creds, analytics token) — fill these in.
#   2. Logs Docker into ECR (public + the pull-through cache).
#   3. Maps this agent's spawn number to a specific MIG slice UUID and pins the
#      job to it via BUILDKITE_PLUGIN_DOCKER_GPUS.
#   4. Serializes the first docker pull of the job image across the many agents
#      on the host (flock), so 56 agents don't all pull at once.
#
# This template assumes the H200 MIG layout from scripts/setup_mig_h200.sh,
# with agents spawned with names ending in -<N> (N = 1..num_slices).
#
# MIG profiles (8-GPU H200):
#   - 1g.18gb: 7 slices/GPU -> 56 agents (queue=h200_18gb), SLICES_PER_GPU=7
#   - 1g.35gb: 4 slices/GPU -> 32 agents (queue=h200_35gb), SLICES_PER_GPU=4
# Set SLICES_PER_GPU to match the MIG profile and the agent cfg `spawn` value.
#
# Exit-code convention:
#   - exit 1   = genuine misconfiguration (wrong spawn count, stale CDI spec).
#                The job fails immediately.
#   - exit 202-205 = a provider/infrastructure call failed every in-hook retry:
#                202 ECR public login, 203 ECR pull-through-cache login,
#                204 GPU discovery (nvidia-smi -L), 205 docker pull. The agent
#                preserves a hook's exit code as the job's exit status, so each
#                failure is told apart in Buildkite, and the generated steps
#                retry 201-205 once (pre-checkout uses 201). No test or agent
#                exits in that range.

set -eo pipefail

# Provider calls retry in place before giving up: 5 attempts, sleeping 2/4/8/16 s
# between them, then exit with the call's own code (202-205) so the generated
# steps' automatic retry re-runs the job. Use only for provider/infra failures.
#
# Every retry that fires also records "<class>,<attempts>,<outcome>" under the
# build meta-data key infra-retry:<job id>:<class>, one key per class so a
# retry in another hook never overwrites it. Recording must never fail or
# stall the job: the agent retries the write for minutes when its API is
# unreachable.
# mark_retry <class> <attempts> <outcome>
mark_retry() {
  timeout 10 buildkite-agent meta-data set "infra-retry:${BUILDKITE_JOB_ID:-}:$1" "$1,$2,$3" || true
}

# retry_or_fail <class> <exit code> <description> <command> [args...]
# <class> names the call in its retry mark, so retries of different calls in
# one job each keep their own count; <exit code> tells them apart in Buildkite.
retry_or_fail() {
  local class=$1 code=$2 description=$3 attempt delay=2
  shift 3
  for (( attempt = 1; ; attempt++ )); do
    if "$@"; then
      (( attempt == 1 )) || mark_retry "$class" "$attempt" recovered
      return 0
    fi
    if (( attempt >= 5 )); then
      echo "ERROR: $description failed after $attempt attempts (provider/infrastructure failure — exiting $code to trigger the infra retry)" >&2
      mark_retry "$class" "$attempt" exhausted
      exit "$code"
    fi
    echo "WARNING: $description failed (attempt $attempt/5); retrying in ${delay}s" >&2
    sleep "$delay"
    delay=$(( delay * 2 ))
  done
}

# Number of MIG slices per GPU (7 for 1g.18gb, 4 for 1g.35gb).
SLICES_PER_GPU=7

# ── Secrets (FILL THESE IN) ───────────────────────────────────────────────────
export HF_TOKEN="<hf-token>"
export AWS_ACCESS_KEY_ID="<aws-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<aws-secret-access-key>"
export BUILDKITE_ANALYTICS_TOKEN="<analytics-token>"   # optional

# ── Hugging Face cache ────────────────────────────────────────────────────────
# Point at large shared/local storage. The h200_18gb docker plugin mounts
# /mnt/vllm-ci into containers, so keep HF_HOME on that path.
export HF_HOME=/mnt/vllm-ci

# ── ECR login ─────────────────────────────────────────────────────────────────
# --cli-connect-timeout bounds one hung connect (the CLI default is 60 s).
ecr_public_login() {
  aws --cli-connect-timeout 10 ecr-public get-login-password --region us-east-1 \
    | docker login --username AWS --password-stdin public.ecr.aws
}
ecr_cache_login() {
  aws --cli-connect-timeout 10 ecr get-login-password --region us-west-2 \
    | docker login --username AWS --password-stdin 936637512419.dkr.ecr.us-west-2.amazonaws.com
}
retry_or_fail ecr-public-login 202 "ECR public login" ecr_public_login
retry_or_fail ecr-cache-login 203 "ECR pull-through-cache login" ecr_cache_login

# ── Pin this agent to one MIG slice ───────────────────────────────────────────
# Agent names look like "<host>-<N>"; N selects the MIG device.
AGENT_NUMBER="${BUILDKITE_AGENT_NAME##*-}"
if [[ -z "$AGENT_NUMBER" ]]; then
  echo "ERROR: Could not extract agent number from BUILDKITE_AGENT_NAME=$BUILDKITE_AGENT_NAME"
  exit 1
fi

# Assigns $nvidia_smi_list in the current shell so retry_or_fail can re-run it.
list_gpus() { nvidia_smi_list=$(nvidia-smi -L); }
retry_or_fail gpu-discovery 204 "nvidia-smi -L" list_gpus
mapfile -t UUIDS < <(grep -oP 'UUID: \KMIG-[^\)]+' <<< "$nvidia_smi_list")
if (( AGENT_NUMBER < 1 || AGENT_NUMBER > ${#UUIDS[@]} )); then
  echo "ERROR: Agent number $AGENT_NUMBER exceeds available MIG devices (${#UUIDS[@]})"
  exit 1
fi

IDX=$(( AGENT_NUMBER - 1 ))
UUID="${UUIDS[$IDX]}"
GPU=$(( IDX / SLICES_PER_GPU ))
SLOT=$(( IDX % SLICES_PER_GPU ))
echo "Agent $BUILDKITE_AGENT_NAME (#$AGENT_NUMBER) → GPU $GPU slot $SLOT → $UUID"
export BUILDKITE_PLUGIN_DOCKER_GPUS="device=${UUID}"

# ── Serialize the first image pull across agents on this host ─────────────────
if [[ -n "${BUILDKITE_PLUGIN_DOCKER_IMAGE:-}" ]]; then
  IMAGE="$BUILDKITE_PLUGIN_DOCKER_IMAGE"
elif [[ -n "${BUILDKITE_COMMIT:-}" ]]; then
  if [[ "${BUILDKITE_BRANCH:-}" == "main" ]]; then
    IMAGE="<main-image>"        # e.g. the postmerge CI image
  else
    IMAGE="<branch-image>"      # e.g. the premerge CI image
  fi
else
  IMAGE=""
fi

if [[ -n "$IMAGE" ]]; then
  LOCK_DIR="/tmp/docker-pull-locks"
  mkdir -p "$LOCK_DIR"
  LOCK_FILE="${LOCK_DIR}/$(echo "$IMAGE" | tr '/:' '__').lock"
  DONE_FILE="${LOCK_FILE}.done"
  if [[ -f "$DONE_FILE" ]]; then
    echo "Image $IMAGE already pulled (done marker exists), skipping pull."
  else
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      echo "Waiting for another agent to finish pulling $IMAGE..."
      flock 9
      # The winner's pull succeeded only if it left the done marker. If it used
      # every retry, fail now rather than repeat them all behind the lock, one
      # agent after another; the job-level retry runs this job again.
      if [[ ! -f "$DONE_FILE" ]]; then
        echo "ERROR: another agent's docker pull $IMAGE failed (provider/infrastructure failure — exiting 205 to trigger the infra retry)" >&2
        exit 205
      fi
    fi
    # Retries hold the lock so the other agents wait instead of stampeding.
    if [[ -f "$DONE_FILE" ]]; then
      echo "Image $IMAGE is now available."
    else
      echo "Pulling image $IMAGE..."
      retry_or_fail image-pull 205 "docker pull $IMAGE" docker pull "$IMAGE"
      touch "$DONE_FILE"
      echo "Image pull complete."
    fi
    exec 9>&-
  fi
fi

# ── CDI device injection + shallow git clones ─────────────────────────────────
# The CDI script pipes into `grep -q`, which exits at the first match; under
# pipefail the writer's SIGPIPE would read as a missing device.
set +o pipefail
source /usr/local/libexec/buildkite-gpu-cdi-env.sh
export BUILDKITE_GIT_CLONE_FLAGS="-v --depth=1 --filter=blob:none"
export BUILDKITE_GIT_FETCH_FLAGS="-v --prune --depth=1"
